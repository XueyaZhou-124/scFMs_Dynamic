# --- data & outputs (large / reproducible locally) ---
# Demo: only track slim `data/raw/emt.h5ad` (under GitHub size limit); other .h5ad stay ignored.
# data/embeddings/、data/processed/、data/deepruot_input/、data/external/ 等仍被 data/* 忽略，勿提交。
data/*
!data/raw/
!data/raw/**
results/
artifacts/
logs/
tmp_benchmark_config/
temp.toml

# User-downloaded weights (never commit)
pretrained_models/

# AnnData / single-cell & tables (exception: slim demo only)
*.h5ad
!data/raw/emt.h5ad
*.loom
*.zarr/

# ML checkpoints & weights
*.ckpt
*.pth
*.pt
*.pt2
*.safetensors
*.bin
*.onnx
*.pb
*.weights
*.index

# numpy / serialization
*.npy
*.npz
*.pkl
*.pickle
*.joblib

# tabular exports (often huge); remove this line if you need small CSVs in git
*.csv

# archives (datasets / dumps)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# HDF5
*.h5
*.hdf5

# logs & experiment trackers
wandb/
mlruns/
tensorboard*/
runs/
lightning_logs/

# environment
.pixi/
.fake_cuda/
.pytest_cache/
__pycache__/
.ipynb_checkpoints/
.DS_Store
__MACOSX/

# Generated manuscript figure outputs (source notebooks/scripts remain trackable)
main_figures/**/*.pdf
main_figures/**/*.png
main_figures/**/*.svg
main_figures/**/*.tif
main_figures/**/*.tiff
main_figures/*.executed.ipynb
main_figures/fig*/
main_figures/true_vs_pred*/

# Generated revision benchmark configs; add stable configs explicitly when public.
configs/benchmark_config/downsample/
configs/benchmark_config/downsample_ebdata/
configs/benchmark_config/synthetic/
configs/benchmark_config/synthetic_branching_controlled/
configs/emb_configs/downsample/
configs/emb_configs/downsample_ebdata/
configs/emb_configs/synthetic/
configs/emb_configs/synthetic_branching_controlled/
data/raw/synthetic_branching/

# DeepRUOT training / run logs (regenerated locally)
DeepRUOTv2/logs/
